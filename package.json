{
  "name": "tale-align",
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelcole/tale-align.git"
  },
  "homepage": "https://github.com/samuelcole/tale-align#readme",
  "bugs": "https://github.com/samuelcole/tale-align/issues",
  "description": "Forced-align public-domain audiobooks to their texts and export EPUB 3 with Media Overlays — with quality gates that refuse to ship a bad alignment.",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "tale-align": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "worker",
    "FORMAT.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test test/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.ts"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/adm-zip": "^0.5",
    "@types/node": "^24",
    "typescript": "^5.9.0"
  }
}
